      "at_frac": 0,
      "label": "pulling finance data"
     },
     {
      "at_frac": 0.25,
      "label": "drafting ARR section"
     },
     {
      "at_frac": 0.5,
      "label": "drafting burn and runway"
     },
     {
      "at_frac": 0.75,
      "label": "drafting hiring section"
     }
    ]
   },
   "research_sources": {
    "duration_s": 120,
    "amend_policy": {
     "type": "restart",
     "duration_s": 60
    }
   }
  }
 },
 "turns": [
  {
   "turn_id": "u1",
   "text": "Start drafting this month's board update: ARR, burn and runway, and hiring.",
   "trigger": {
    "type": "at",
    "t": 0.5
   }
  },
  {
   "turn_id": "u2",
   "text": "And can you also scan what competitors are charging these days?",
   "trigger": {
    "type": "after_agent_idle",
    "gap": 1.2,
    "max_wait": 10
   }
  },
  {
   "turn_id": "u3",
   "text": "Where are we on the board update?",
   "trigger": {
    "type": "after_agent_idle",
    "gap": 1.2,
    "max_wait": 10
   }
  },
  {
   "turn_id": "u4",
   "text": "Never mind the competitor stuff, I don't need it. Keep the board update going though.",
   "trigger": {
    "type": "after_agent_idle",
    "gap": 1.2,
    "max_wait": 10
   }
  },
  {
   "turn_id": "u5",
   "text": "Hold on, give me a second, someone's at my door.",
   "trigger": {
    "type": "after_agent_idle",
    "gap": 1.2,
    "max_wait": 10
   },
   "tts_style": "hurried"
  },
  {
   "turn_id": "u6",
   "text": "Sorry, I'm back.",
   "trigger": {
    "type": "after_turn",
    "ref": "u5",
    "delay": 16
   }
  }
 ],
