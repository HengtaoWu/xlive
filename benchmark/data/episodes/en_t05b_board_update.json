    "web research"
   ]
  },
  "materials": {
   "report": {
    "title": "March Board Update",
    "sections": [
     "ARR: $4.1M, up 6% month over month",
     "Burn: $310k/month, 19 months runway",
     "Hiring: 3 of 5 roles filled"
    ],
    "headline": "ARR reached $4.1M (+6% MoM) with 19 months of runway."
   },
   "sources": [
    {
     "title": "SaaS pricing benchmarks 2026",
     "publisher": "PriceLabs"
    }
   ]
  },
  "tool_behaviors": {
   "generate_report": {
    "duration_s": 72,
    "amend_policy": {
     "type": "restart",
