   }
  }
 ],
 "checkpoints": [
  {
   "cp_id": "c1",
   "turn_id": "u3",
   "type": "status_answer",
   "must": "Report the real stage of the board update.",
   "must_not": "Invent a percentage or talk about the pricing scan.",
   "judge_hints": {
    "answer_keywords": [
     [
      "drafting",
      "ARR",
      "pulling",
      "section"
     ]
    ],
    "min_groups": 1,
    "forbidden": []
   }
  },
  {
   "cp_id": "c2",
   "turn_id": "u4",
   "type": "selective_cancel",
   "must": "Stop only the pricing scan; confirm the update continues.",
   "must_not": "Cancel the board update too.",
   "judge_hints": {
    "answer_keywords": [
     [
      "pricing",
      "scan",
      "competitor"
     ],
     [
      "update",
      "board"
     ]
    ],
    "min_groups": 2,
    "forbidden": []
   }
  },
  {
   "cp_id": "c3",
   "turn_id": "u5",
   "type": "silence_request",
   "must": "Stay quiet or give a very short ack; don't cancel anything.",
   "must_not": "Keep talking; cancel tasks.",
   "judge_hints": {
    "answer_keywords": [
     [
      "sure",
      "okay"
     ]
    ],
    "min_groups": 1,
    "forbidden": []
   },
   "latency": false
  },
  {
   "cp_id": "c4",
   "turn_id": "u6",
   "type": "resume",
   "must": "Welcome back + current status or the finished update.",
   "must_not": "Mention the pricing scan as running.",
   "judge_hints": {
    "answer_keywords": [
     [
      "welcome back",
      "board update",
      "update"
     ]
    ],
    "min_groups": 1,
    "forbidden": []
   }
  }
 ],
 "failure_conditions": [
