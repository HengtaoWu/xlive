{
  "name": "xlive-client",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "keywords": [
    "xtalk",
    "frontend",
    "speech",
    "ai",
    "client",
    "websocket"
  ],
  "description": "X-Live browser client derived from X-Talk",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./umd": "./dist/index.umd.cjs",
    "./iife": "./dist/index.iife.min.js"
  },
  "unpkg": "dist/index.iife.min.js",
  "jsdelivr": "dist/index.iife.min.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:app",
    "build:client": "webpack --config webpack.config.mjs --mode production",
    "build:app": "webpack --config webpack.app.config.mjs --mode production",
    "check:app": "tsc -p app/tsconfig.json --noEmit",
    "dev": "webpack serve --config webpack.app.config.mjs --mode development",
    "watch": "webpack --mode development --watch",
    "docs": "typedoc --options typedoc.json",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "katex": "^0.16.22",
    "three": "^0.186.0"
  }
}
